{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlasbrasil.local/schemas/atlas-city-comparison.schema.json",
  "title": "AtlasCityComparison",
  "type": "object",
  "required": ["version", "uf", "generatedAt", "title", "cities", "metrics", "readings", "recommendations", "limitations", "sources"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "uf": { "type": "string", "minLength": 2, "maxLength": 2 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "title": { "type": "string", "minLength": 1 },
    "cities": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["cityId", "name", "role"],
        "additionalProperties": false,
        "properties": {
          "cityId": { "type": "string", "minLength": 7, "maxLength": 7 },
          "name": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "unit", "kind", "values", "interpretation"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "unit": { "type": "string" },
          "kind": { "enum": ["measured", "proxy", "simulation"] },
          "values": {
            "type": "object",
            "additionalProperties": { "type": "number" }
          },
          "interpretation": { "type": "string" }
        }
      }
    },
    "readings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "claim", "kind", "confidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "claim": { "type": "string" },
          "kind": { "enum": ["factual", "inference", "simulation", "recommendation"] },
          "confidence": { "enum": ["baixa", "media", "alta"] },
          "limits": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "action", "risk", "confidence"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "action": { "type": "string" },
          "risk": { "type": "string" },
          "confidence": { "enum": ["baixa", "media", "alta"] }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "sources": { "type": "array", "items": { "type": "string" } },
    "reportPath": { "type": "string" }
  }
}
