{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlasbrasil.local/schemas/atlas-domain-comparison.schema.json",
  "title": "AtlasDomainComparison",
  "type": "object",
  "required": ["version", "uf", "generatedAt", "title", "cities", "domains", "recommendations", "limitations", "sources", "reportPath"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "uf": { "type": "string", "minLength": 2, "maxLength": 2 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "title": { "type": "string", "minLength": 1 },
    "cities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["cityId", "name", "role"],
        "additionalProperties": false,
        "properties": {
          "cityId": { "type": "string", "minLength": 7, "maxLength": 7 },
          "name": { "type": "string" },
          "role": { "type": "string" }
        }
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "leaderCityId", "stance", "interpretation", "values", "missingData"],
        "additionalProperties": false,
        "properties": {
          "id": { "enum": ["pharmacy", "bakery", "clinic", "technical_course", "health_career", "technical_career"] },
          "label": { "type": "string" },
          "leaderCityId": { "type": "string", "minLength": 7, "maxLength": 7 },
          "stance": { "enum": ["investigar", "faltam_dados", "risco_alto", "adiar"] },
          "interpretation": { "type": "string" },
          "values": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["readiness", "evidence", "stance", "confidence"],
              "additionalProperties": false,
              "properties": {
                "readiness": { "type": "number", "minimum": 0, "maximum": 100 },
                "evidence": { "type": "number", "minimum": 0, "maximum": 100 },
                "stance": { "enum": ["investigar", "faltam_dados", "risco_alto", "adiar"] },
                "confidence": { "enum": ["baixa", "media", "alta"] }
              }
            }
          },
          "missingData": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "action", "risk", "confidence"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "action": { "type": "string" },
          "risk": { "type": "string" },
          "confidence": { "enum": ["baixa", "media", "alta"] }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "sources": { "type": "array", "items": { "type": "string" } },
    "reportPath": { "type": "string" }
  }
}
