{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlasbrasil.local/schemas/atlas-domain-screening.schema.json",
  "title": "AtlasDomainScreening",
  "type": "object",
  "required": ["version", "uf", "cityId", "name", "generatedAt", "domains", "disclaimer", "limitations"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "uf": { "type": "string", "minLength": 2, "maxLength": 2 },
    "cityId": { "type": "string", "minLength": 7, "maxLength": 7 },
    "name": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "readiness", "evidence", "stance", "confidence", "why", "missingData", "risk"],
        "additionalProperties": false,
        "properties": {
          "id": { "enum": ["pharmacy", "bakery", "clinic", "technical_course", "health_career", "technical_career"] },
          "label": { "type": "string" },
          "readiness": { "type": "number", "minimum": 0, "maximum": 100 },
          "evidence": { "type": "number", "minimum": 0, "maximum": 100 },
          "stance": { "enum": ["investigar", "faltam_dados", "risco_alto", "adiar"] },
          "confidence": { "enum": ["baixa", "media", "alta"] },
          "why": { "type": "string" },
          "missingData": { "type": "array", "items": { "type": "string" } },
          "risk": { "type": "string" }
        }
      }
    },
    "disclaimer": { "type": "string", "minLength": 1 },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "sources": { "type": "array", "items": { "type": "string" } }
  }
}
