{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlasbrasil.local/schemas/atlas-forecast-ledger.schema.json",
  "title": "AtlasForecastLedger",
  "type": "object",
  "required": ["version", "uf", "generatedAt", "forecasts", "limitations"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string" },
    "uf": { "type": "string", "minLength": 2, "maxLength": 2 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "forecasts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question", "horizon", "baseRate", "prediction", "confidence", "resolutionMetric", "status", "limits"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "question": { "type": "string" },
          "horizon": { "type": "string" },
          "baseRate": { "type": "string" },
          "prediction": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "resolutionMetric": { "type": "string" },
          "status": { "enum": ["open", "resolved", "archived"] },
          "limits": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
