{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlasbrasil.local/schemas/atlas-synthetic-cohort.schema.json",
  "title": "AtlasSyntheticCohortPack",
  "type": "object",
  "required": ["version", "scope", "privacy", "archetypes", "limitations"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "required": ["uf", "level"],
      "additionalProperties": false,
      "properties": {
        "uf": { "type": "string", "minLength": 2, "maxLength": 2 },
        "level": { "enum": ["country", "state", "region", "city"] },
        "cityId": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "sourceSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "privateSource": { "type": "string" },
        "rawPersonaCount": { "type": "integer", "minimum": 0 },
        "publishedPersonaCount": { "const": 0 },
        "aggregationMethod": { "type": "string" }
      }
    },
    "privacy": {
      "type": "object",
      "required": ["rawPersonasPublished", "redactionLevel", "policy"],
      "additionalProperties": false,
      "properties": {
        "rawPersonasPublished": { "const": false },
        "redactionLevel": { "enum": ["aggregate_only", "archetype_only"] },
        "policy": { "type": "string", "minLength": 1 }
      }
    },
    "archetypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "weight", "attributes", "decisionDrivers", "confidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 },
          "attributes": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } },
          "decisionDrivers": { "type": "array", "items": { "type": "string" } },
          "confidence": { "enum": ["baixa", "media", "alta"] },
          "limitations": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "manifestHash": { "type": "string" }
  }
}
